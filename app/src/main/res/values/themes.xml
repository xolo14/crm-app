<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SyncpediaDark" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/syncpedia_teal</item>
        <item name="colorPrimaryDark">@color/bg_toolbar</item>
        <item name="colorPrimaryVariant">@color/bg_toolbar</item>
        <item name="colorSecondary">@color/syncpedia_orange</item>
        <item name="colorAccent">@color/syncpedia_orange</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <item name="colorError">@color/logout_red</item>
    </style>

    <style name="DarkTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/syncpedia_teal</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="boxBackgroundColor">@color/bg_card</item>
    </style>

    <style name="LoginTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/syncpedia_blue</item>
        <item name="hintTextColor">@color/login_subtitle</item>
        <item name="android:textColorHint">@color/login_subtitle</item>
        <item name="boxBackgroundColor">@color/login_card</item>
        <item name="boxStrokeWidth">1dp</item>
    </style>

    <style name="FilterTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:layout_marginEnd">8dp</item>
    </style>

    <style name="BottomNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/tab_unselected</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="DialKey" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/bg_card</item>
        <item name="cornerRadius">40dp</item>
        <item name="rippleColor">@color/syncpedia_teal</item>
    </style>

    <style name="InCallKey" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_on_toolbar</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">#2A4A40</item>
        <item name="cornerRadius">28dp</item>
        <item name="rippleColor">@color/syncpedia_teal</item>
    </style>
</resources>
