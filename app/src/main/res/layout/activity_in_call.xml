<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_toolbar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="SYNCPEDIA PHONE"
            android:textAllCaps="true"
            android:textColor="@color/syncpedia_teal"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Calling…"
            android:textColor="@color/text_on_toolbar"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvCallAvatar"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_badge_blue"
            android:gravity="center"
            android:textColor="@color/text_on_primary"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCallName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_on_toolbar"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCallNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="#B8C9C3"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/tvCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="00:00"
            android:textColor="@color/text_on_toolbar"
            android:textSize="17sp"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvRecordingBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="● Recording"
            android:textColor="@color/syncpedia_orange"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvDtmfDigits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/syncpedia_teal"
            android:textSize="20sp"
            android:visibility="gone"/>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- In-call DTMF keypad (toggle) -->
        <GridLayout
            android:id="@+id/panelDtmf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:alignmentMode="alignBounds"
            android:columnCount="3"
            android:rowCount="4"
            android:useDefaultMargins="true"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf1" style="@style/InCallKey" android:text="1"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf2" style="@style/InCallKey" android:text="2"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf3" style="@style/InCallKey" android:text="3"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf4" style="@style/InCallKey" android:text="4"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf5" style="@style/InCallKey" android:text="5"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf6" style="@style/InCallKey" android:text="6"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf7" style="@style/InCallKey" android:text="7"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf8" style="@style/InCallKey" android:text="8"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf9" style="@style/InCallKey" android:text="9"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmfStar" style="@style/InCallKey" android:text="*"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmf0" style="@style/InCallKey" android:text="0"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/dtmfHash" style="@style/InCallKey" android:text="#"/>
        </GridLayout>

        <!-- Connected: 2×3 grid — End call centered on row 2 -->
        <LinearLayout
            android:id="@+id/rowCallTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:id="@+id/btnRecWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btnRec"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_incall_btn"
                        android:gravity="center"
                        android:text="Rec"
                        android:textColor="@color/text_on_toolbar"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvRecLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Record"
                        android:textColor="#B8C9C3"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMuteWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btnMute"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_incall_btn"
                        android:gravity="center"
                        android:text="Mute"
                        android:textColor="@color/text_on_toolbar"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvMuteLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Mute"
                        android:textColor="#B8C9C3"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnKeypadWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btnKeypad"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_incall_btn"
                        android:gravity="center"
                        android:text="Pad"
                        android:textColor="@color/text_on_toolbar"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Keypad"
                        android:textColor="#B8C9C3"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnSpeakerWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btnSpeaker"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_incall_btn"
                        android:gravity="center"
                        android:text="Spk"
                        android:textColor="@color/text_on_toolbar"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvSpeakerLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Speaker"
                        android:textColor="#B8C9C3"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnEndCallWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEndCall"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:backgroundTint="@color/logout_red"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text=""
                        app:cornerRadius="32dp"
                        app:icon="@drawable/ic_call"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="26dp"
                        app:iconTint="@color/text_on_primary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="End call"
                        android:textColor="#B8C9C3"
                        android:textSize="11sp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnHoldWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/btnHold"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_incall_btn"
                        android:gravity="center"
                        android:text="Hold"
                        android:textColor="@color/text_on_toolbar"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvHoldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Hold"
                        android:textColor="#B8C9C3"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Incoming: Answer + Decline -->
        <LinearLayout
            android:id="@+id/rowIncomingActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDecline"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:backgroundTint="@color/logout_red"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text=""
                    app:cornerRadius="36dp"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="28dp"
                    app:iconTint="@color/text_on_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Decline"
                    android:textColor="#B8C9C3"
                    android:textSize="12sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnswer"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:backgroundTint="@color/incoming_green"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text=""
                    app:cornerRadius="36dp"
                    app:icon="@drawable/ic_call"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="28dp"
                    app:iconTint="@color/text_on_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Answer"
                    android:textColor="#B8C9C3"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
